
{
  "name": "zev-dod-apex-1",
  "main": "worker.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zev-dod-apex-db",
      "database_id": "733fa817-1a29-4d62-8026-fb5158683835"
    }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health",
      "/test-ai",
      "/analyze",
      "/api/*"
    ]
  }
}
